{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "description": "Root workspace orchestrator for Nexus monorepo — manages shared scripts, dependencies, and build pipelines.",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "protocols/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.11.6",
    "typescript": "^5.4.5",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^7.1.6"
  }
}
