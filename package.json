{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "description": "Root workspace orchestrator for Nexus monorepo — manages shared scripts, dependencies, and build pipelines.",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.11.6",
    "typescript": "^5.4.5",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5"
  }
}
